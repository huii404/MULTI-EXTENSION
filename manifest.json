{
  "manifest_version": 3,
  "name": "Multi Tool Hub",
  "version": "2.0.0",
  "description": "Đánh giá DTU nhanh, Tải tài liệu Studocu, chụp ảnh web,...",
  "icons": {
    "16": "icons/a.png",
    "32": "icons/b.png",
    "48": "icons/c.png",
    "128": "icons/d.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/a.png",
      "32": "icons/b.png",
      "48": "icons/c.png",
      "128": "icons/d.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "downloads",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://mydtu.duytan.edu.vn/*",
    "*://*.studocu.com/*",
    "*://*.studocu.vn/*",
    "*://*.scribd.com/*",
    "*://*.scribd.vn/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mydtu.duytan.edu.vn/sites/index.aspx*"
      ],
      "js": [
        "src/features/dtu-univer/dtu-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.studocu.com/*",
        "*://*.studocu.vn/*"
      ],
      "js": [
        "src/features/document-download/studocu/studocu-content.js"
      ],
      "css": [
        "styles/custom-styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.scribd.com/*",
        "*://*.scribd.vn/*"
      ],
      "js": [
        "src/features/document-download/scribd/scribd-content.js"
      ],
      "css": [
        "styles/custom-styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/tesseract.min.js",
        "libs/tesseract/worker.min.js",
        "libs/tesseract/tesseract-core.wasm.js",
        "styles/viewer-styles.css",
        "styles/custom-styles.css",
        "libs/html2canvas/html2canvas.min.js",
        "libs/jsPDF/jspdf.umd.min.js",
        "src/features/text-tools/text-tools.html",
        "src/features/text-tools/cleaner/cleaner.html",
        "src/features/text-tools/cleaner/cleaner.js",
        "src/features/text-tools/comparator/comparator.html",
        "src/features/text-tools/comparator/comparator.js",
        "src/features/dtu-univer/dtu-univer.html",
        "src/features/dtu-univer/skills/rating/rating.html",
        "src/features/dtu-univer/skills/schedule/schedule.html",
        "src/features/dtu-univer/skills/course-register/course-register.html",
        "src/features/dtu-univer/skills/course-register/course-register.js",
        "src/features/qrcode/qrcode.html",
        "src/features/document-download/document-download.html",
        "src/features/document-download/studocu/studocu.html",
        "src/features/document-download/scribd/scribd.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}